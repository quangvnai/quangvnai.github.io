{
  "name": "hugo-blox-academic-cv-starter",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "description": "Academic CV starter template for Hugo Blox with Tailwind CSS v4",
  "scripts": {
    "dev": "hugo server --disableFastRender",
    "build": "hugo --gc --minify && pnpm dlx pagefind --source 'public'",
    "vercel-build": "hugo --gc --minify -b https://$VERCEL_PROJECT_PRODUCTION_URL && pnpm dlx pagefind --source 'public'"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/typography": "^0.5.10",
    "preact": "^10.27.2",
    "tailwindcss": "^4.1.12"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "hugo-bin": "0.149.2"
  }
}
